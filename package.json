{
  "name": "dsh-agent-history-import",
  "version": "1.0.0",
  "description": "Import local Codex, Pi, and Claude Code conversation histories into DSH and continue them",
  "license": "MIT",
  "author": "sirius2alpha",
  "homepage": "https://github.com/sirius2alpha/dsh-agent-history-import#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sirius2alpha/dsh-agent-history-import.git"
  },
  "bugs": {
    "url": "https://github.com/sirius2alpha/dsh-agent-history-import/issues"
  },
  "icon": "./icon.svg",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "LICENSE",
    "README.md",
    "index.js",
    "client.js",
    "src",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "session-import",
    "codex",
    "pi",
    "claude-code"
  ],
  "engines": {
    "dsh": ">=0.2.2-rc.3 <0.3.0-0",
    "node": "^22.19.0 || >=24.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-api-session-controller"
      ]
    }
  }
}
